# Parley Server Host configuration.
#
#   cp .env.example .env        # then edit
#
# Every variable is optional. With no .env, all Providers resolve to mock and
# the app runs in Demo Mode. This file must only ever hold empty or example
# values; real keys belong in the untracked .env.
#
# Provider variables are commented out on purpose: an empty value is not the
# same as an unset one. Uncomment the ones you use.

# --- Server ---------------------------------------------------------------
# HTTP port the Node Server Host listens on. Inside Docker, Caddy proxies to
# this port, so normally leave it at 3000.
PORT=3000

# Optional shared passphrase for a self-hosted Server Host. It is not an
# account: there are no usernames, profiles or registration. Leave empty on a
# LAN you trust; set it before exposing the host to the internet. The server
# rejects WebSocket connections whose ?token= does not match; the built-in web
# client prompts once per tab and sends it as ?token= (sessionStorage only).
ACCESS_TOKEN=

# DNS name for TLS. Empty means Caddy uses its internal CA (trust the root CA
# on each phone, see deploy/README.md). Set a name such as
# parley.example.com to get an automatic Let's Encrypt certificate; ports 80
# and 443 must then be reachable from the internet.
PUBLIC_DOMAIN=

# --- Translator (OpenAI-compatible) --------------------------------------
# LLM_PRESET is one of: groq | gemini | siliconflow | dashscope | openrouter |
# ollama | custom | mistral | deepseek | zhipu | moonshot | cerebras.
# LLM_BASE_URL and LLM_MODEL override the Preset defaults.
# LLM_API_KEY is the key for that endpoint (empty for ollama).
# LLM_EXTRA_BODY is a JSON object shallow-merged into every request body. It
# carries provider-specific parameters only; Parley always sets model, messages
# and stream. Invalid JSON or a non-object is rejected with an error naming
# LLM_EXTRA_BODY when the translator Provider is created.
# LLM_PRESET=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_EXTRA_BODY={"top_k":20}

# --- ASR ------------------------------------------------------------------
# ASR_PROVIDER is one of: deepgram | paraformer | whisperlivekit | mock.
# Unset means mock (Demo Mode).
# ASR_PROVIDER=deepgram
# WHISPERLIVEKIT_URL=http://whisperlivekit:8000
# DEEPGRAM_API_KEY=
# DASHSCOPE_API_KEY=

# --- TTS ------------------------------------------------------------------
# TTS_PROVIDER is one of: system | kokoro | azure | edge | cosyvoice | mock.
# Unset means mock (Demo Mode). "system" means the browser's speechSynthesis
# and needs no URL or key.
# TTS_PROVIDER=kokoro
# KOKORO_URL=http://kokoro:8880
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
